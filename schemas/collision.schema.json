{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRBench collision",
  "type": "object",
  "properties": {
    "joint_sample_step_rad": {
      "const": 0.04
    },
    "scoring_tolerance_mm": {
      "const": 10
    },
    "record_cap": {
      "const": 1000
    },
    "robot_name_prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_object_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_unresolved_exclusions": {
      "type": "boolean"
    }
  },
  "propertyNames": {
    "if": {"pattern": "^allow_unresolved_"},
    "then": {"const": "allow_unresolved_exclusions"}
  },
  "required": [
    "joint_sample_step_rad",
    "scoring_tolerance_mm",
    "record_cap",
    "robot_name_prefixes",
    "excluded_object_roots"
  ],
  "additionalProperties": true
}
